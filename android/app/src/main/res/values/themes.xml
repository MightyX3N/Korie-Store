<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PlayBigScreen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/shade</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/shade</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
    <style name="Theme.PlayBigScreen.Full">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
